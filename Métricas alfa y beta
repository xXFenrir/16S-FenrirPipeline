  add_option("--metadata", type="character", default=NULL) |>
  add_option("--topn", type="integer", default={topn_genus})
opt <- parse_args(opt)
outdir  <- opt$outdir
plotdir <- file.path(outdir, "plots_r"); if (!dir.exists(plotdir)) dir.create(plotdir, recursive = TRUE)
