def plot_distance_heatmap(dm_path: Path, out_name: str, outdir: Path, interactive: bool=False):
    D = pd.read_csv(dm_path, sep="\t", index_col=0)
    labels = list(D.index)
    # reordenar por clustering si scipy está
    order = list(range(len(labels)))
    if _HAS_SCIPY:
        try:
            Z = linkage(squareform(D.values, checks=False), method="average")
            order = leaves_list(Z).tolist()
            # dendrograma PNG
            if _HAS_MPL:
                od = outdir / "plots_py"; ensure_dir(od)
                plt.figure(figsize=(8,4)); dendrogram(Z, labels=labels, leaf_rotation=90)
                plt.title(f"Dendrograma — {out_name}"); plt.tight_layout()
                plt.savefig(od / f"dendrogram_{out_name}.png", dpi=150); plt.close()
        except Exception as e:
            eprint(f"[WARN] Clustering falló: {e}")
    D2 = D.values[np.ix_(order,order)]
    lbl2 = [labels[i] for i in order]
    if _HAS_MPL and not interactive:
        od = outdir / "plots_py"; ensure_dir(od)
        plt.figure(figsize=(7,6))
        im = plt.imshow(D2, aspect="auto")
        plt.colorbar(im,label="dist"); plt.xticks(range(len(lbl2)), lbl2, rotation=90); plt.yticks(range(len(lbl2)), lbl2)
        plt.title(f"Heatmap distancias — {out_name}"); plt.tight_layout()
        plt.savefig(od / f"heatmap_{out_name}.png", dpi=150); plt.close()
    if _HAS_PLOTLY and interactive:
        od = outdir / "plots_interactive"; ensure_dir(od)
        fig = px.imshow(D2, x=lbl2, y=lbl2, aspect="auto", title=f"Heatmap distancias — {out_name}")
        fig.write_html(str(od / f"heatmap_{out_name}.html"))

def build_rel_with_tax(rel_path: Path, tax_path: Path, level: str="genus") -> pd.DataFrame:
    rel = pd.read_csv(rel_path, sep="\t")
    if "feature_id" not in rel.columns: rel.rename(columns={rel.columns[0]:"feature_id"}, inplace=True)
    tax = read_taxonomy(tax_path)
    tax[level] = extract_level(tax["taxonomy"], level=level)
    rel_long = rel.melt(id_vars="feature_id", var_name="sample", value_name="rel")
    rel_long = rel_long.merge(tax[["feature_id", level]], on="feature_id", how="left").fillna({level:"Unassigned"})
    # sumar por nivel taxonómico
    g = rel_long.groupby([level,"sample"], as_index=False)["rel"].sum()
    return g  # columnas: [level, sample, rel]

def plot_stacked_bar_top_taxa(rel_path: Path, tax_path: Path, outdir: Path, level:str="genus", topn:int=10, interactive: bool=False):
    g = build_rel_with_tax(rel_path, tax_path, level)
    # top-N por promedio
    order = g.groupby(level)["rel"].mean().sort_values(ascending=False)
    keep = set(order.head(topn).index)
    g["taxon2"] = np.where(g[level].isin(keep), g[level], "Other")
    g = g.groupby(["taxon2","sample"], as_index=False)["rel"].sum()
    # ancho y orden de muestras estable
    samples = sorted(g["sample"].unique())
    if _HAS_MPL and not interactive:
        od = outdir / "plots_py"; ensure_dir(od)
        pivot = g.pivot(index="sample", columns="taxon2", values="rel").fillna(0.0).reindex(samples)
        pivot.plot(kind="bar", stacked=True, figsize=(12,5))
        plt.xticks(rotation=90); plt.ylabel("Relative abundance"); plt.title(f"Stacked bar — Top {topn} {level} (+Other)")
        plt.tight_layout(); plt.savefig(od / f"stacked_bar_top{topn}_{level}.png", dpi=150); plt.close()
    if _HAS_PLOTLY and interactive:
        od = outdir / "plots_interactive"; ensure_dir(od)
        fig = px.bar(g, x="sample", y="rel", color="taxon2", title=f"Stacked bar — Top {topn} {level} (+Other)")
        fig.update_layout(barmode="stack", xaxis={'categoryorder':'array','categoryarray':samples})
        fig.write_html(str(od / f"stacked_bar_top{topn}_{level}.html"))

def plot_taxa_heatmap(rel_path: Path, tax_path: Path, outdir: Path, level:str="genus", topn:int=20, log1p: bool=True, interactive: bool=False):
    g = build_rel_with_tax(rel_path, tax_path, level)
    top = g.groupby(level)["rel"].mean().sort_values(ascending=False).head(topn).index
    g2 = g[g[level].isin(top)]
    mat = g2.pivot(index=level, columns="sample", values="rel").fillna(0.0)
    if log1p: mat = np.log1p(mat)
    # reordenar por clustering si scipy está
    rows = list(range(mat.shape[0])); cols = list(range(mat.shape[1]))
    rlabels = list(mat.index); clabels = list(mat.columns)
    if _HAS_SCIPY:
        try:
            rZ = linkage(mat.values, method="average"); rows = leaves_list(rZ).tolist()
            cZ = linkage(mat.values.T, method="average"); cols = leaves_list(cZ).tolist()
            rlabels = [mat.index[i] for i in rows]; clabels = [mat.columns[j] for j in cols]
            mat = mat.values[np.ix_(rows, cols)]
        except Exception as e:
            eprint(f"[WARN] Clustering heatmap taxon: {e}"); mat = mat.values
    else:
        mat = mat.values
    if _HAS_MPL and not interactive:
        od = outdir / "plots_py"; ensure_dir(od)
        plt.figure(figsize=(10,6))
        im = plt.imshow(mat, aspect="auto")
        plt.colorbar(im, label="log1p(rel)" if log1p else "rel")
        plt.yticks(range(len(rlabels)), rlabels); plt.xticks(range(len(clabels)), clabels, rotation=90)
        plt.title(f"Heatmap — Top {topn} {level}"); plt.tight_layout()
        plt.savefig(od / f"heatmap_top{topn}_{level}.png", dpi=150); plt.close()
    if _HAS_PLOTLY and interactive:
        od = outdir / "plots_interactive"; ensure_dir(od)
        fig = px.imshow(mat, x=clabels, y=rlabels, aspect="auto", title=f"Heatmap — Top {topn} {level}")
        fig.write_html(str(od / f"heatmap_top{topn}_{level}.html"))

def plot_rank_abundance(rel_path: Path, outdir: Path, max_samples:int=12, interactive: bool=False):
    rel = pd.read_csv(rel_path, sep="\t", index_col=0)  # features x samples
    # si parece invertido, transpone
    if any(pd.Series(rel.index.astype(str)).str.match(r"^(SRR|ERR|DRR)", na=False)): rel = rel.T
    samples = list(rel.columns)[:max_samples]
    Y = [np.sort(rel[s].values)[::-1] for s in samples]
    if _HAS_MPL and not interactive:
        od = outdir / "plots_py"; ensure_dir(od)
        plt.figure(figsize=(8,5))
        for y,s in zip(Y, samples): plt.plot(range(1,len(y)+1), y, label=s)
        plt.xlabel("Rango (desc)"); plt.ylabel("Rel. abundance"); plt.yscale("log")
        plt.title("Rank-abundance (primeras muestras)"); plt.legend(fontsize=7, ncol=2)
        plt.tight_layout(); plt.savefig(od / "rank_abundance.png", dpi=150); plt.close()
    if _HAS_PLOTLY and interactive:
        od = outdir / "plots_interactive"; ensure_dir(od)
        fig = go.Figure()
        for y,s in zip(Y, samples): fig.add_trace(go.Scatter(x=list(range(1,len(y)+1)), y=y, mode="lines", name=s))
        fig.update_layout(title="Rank-abundance (primeras muestras)", xaxis_title="Rango (desc)", yaxis_title="Rel. abundance", yaxis_type="log")
        fig.write_html(str(od / "rank_abundance.html"))

def plot_treemap(rel_path: Path, tax_path: Path, outdir: Path, level:str="phylum", interactive: bool=False):
    g = build_rel_with_tax(rel_path, tax_path, level)
    tot = g.groupby(level, as_index=False)["rel"].mean().sort_values("rel", ascending=False)
    if _HAS_SQUARIFY and _HAS_MPL and not interactive:
        od = outdir / "plots_py"; ensure_dir(od)
        plt.figure(figsize=(8,6))
        squarify.plot(sizes=tot["rel"].values, label=tot[level].values)
        plt.axis('off'); plt.title(f"Treemap — {level} (media relativa)"); plt.tight_layout()
        plt.savefig(od / f"treemap_{level}.png", dpi=150); plt.close()
    if _HAS_PLOTLY and interactive:
        od = outdir / "plots_interactive"; ensure_dir(od)
        fig = px.treemap(tot, path=[level], values="rel", title=f"Treemap — {level} (media relativa)")
        fig.write_html(str(od / f"treemap_{level}.html"))

def plot_sunburst(rel_path: Path, tax_path: Path, outdir: Path, interactive: bool=True):
    if not _HAS_PLOTLY: return
    # construir jerarquía simple: Kingdom -> Phylum -> Class -> Order -> Family -> Genus
    rel = pd.read_csv(rel_path, sep="\t")
    if "feature_id" not in rel.columns: rel.rename(columns={rel.columns[0]:"feature_id"}, inplace=True)
    tax = read_taxonomy(tax_path)
    # promedio por feature_id (promedio sobre muestras de relabund)
    rel["mean_rel"] = rel.drop(columns=["feature_id"]).mean(axis=1)
    df = rel[["feature_id","mean_rel"]].merge(tax, on="feature_id", how="left")
    # parsear
    def parse(t):
        parts = dict(Kingdom="Unassigned", Phylum="Unassigned", Class="Unassigned",
                     Order="Unassigned", Family="Unassigned", Genus="Unassigned")
        if isinstance(t,str):
            for token in t.split(";"):
                token = token.strip()
                if token.startswith("k__"): parts["Kingdom"] = token[3:] or "Unassigned"
                if token.startswith("p__"): parts["Phylum"]  = token[3:] or "Unassigned"
                if token.startswith("c__"): parts["Class"]   = token[3:] or "Unassigned"
                if token.startswith("o__"): parts["Order"]   = token[3:] or "Unassigned"
                if token.startswith("f__"): parts["Family"]  = token[3:] or "Unassigned"
                if token.startswith("g__"): parts["Genus"]   = token[3:] or "Unassigned"
        return parts
    parts = df["taxonomy"].apply(parse).apply(pd.Series)
    df = pd.concat([df, parts], axis=1)
    od = outdir / "plots_interactive"; ensure_dir(od)
    fig = px.sunburst(df, path=["Kingdom","Phylum","Class","Order","Family","Genus"], values="mean_rel",
                      title="Sunburst — composición promedio")
    fig.write_html(str(od / "sunburst_taxonomy.html"))

# ------------------------- CLI & flujo ------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Calcula alfa/beta/PCoA desde salidas EMU y genera plots (Python puro).",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    p.add_argument("--emu-outdir", required=True, type=Path, help="Carpeta con salidas de EMU (por muestra o agregadas).")
    p.add_argument("--outdir", type=Path, default=None, help="Carpeta de salida (por defecto = --emu-outdir).")
    p.add_argument("--min-abundance", type=float, default=0.0, help="Umbral para filtrar relativas al agregar (0 = sin filtro).")
    p.add_argument("--metadata", type=Path, default=None, help="TSV con columna 'sample' y opcional 'group'.")
    p.add_argument("--topn-genus", type=int, default=10, help="Top-N géneros en stacked bar/heatmap.")
    p.add_argument("--plots-static", action="store_true", help="Exportar figuras PNG (matplotlib) en plots_py/.")
    p.add_argument("--plots-interactive", action="store_true", help="Exportar figuras HTML (plotly) en plots_interactive/.")
    return p

def main() -> int:
    args = build_parser().parse_args()
    outdir = args.outdir or args.emu_outdir
    ensure_dir(outdir)

    # 1) Detectar/crear tablas agregadas
    cnt_path = outdir / "feature_table_counts.tsv"
    rel_path = outdir / "feature_table_relabund.tsv"
    tax_path = outdir / "taxonomy.tsv"

    if not (cnt_path.exists() or rel_path.exists()):
        eprint("[INFO] Agregando desde TSV por muestra de EMU…")
        cnt_path, rel_path, tax_path = aggregate_from_per_sample(args.emu_outdir, outdir, args.min_abundance)

    # 2) Leer tabla para métricas
    table = None; is_counts = False
    if cnt_path and cnt_path.exists():
        table = pd.read_csv(cnt_path, sep="\t", index_col=0); is_counts=True
    elif rel_path and rel_path.exists():
        table = pd.read_csv(rel_path, sep="\t", index_col=0); is_counts=False
    else:
        eprint("[ERROR] No encontré ni counts ni relabund."); return 2

    # orientar a features x samples
    if any(pd.Series(table.index.astype(str)).str.match(r"^(SRR|ERR|DRR)", na=False)): table = table.T

    # 3) Alfa
    alpha = alpha_from_table(table, is_counts=is_counts)
    alpha.to_csv(outdir / "alpha_diversity.tsv", sep="\t")

    # 4) Beta + PCoA
    X = table.values.T   # samples x features
    sids = list(table.columns)
    X_rel = X / np.clip(X.sum(axis=1, keepdims=True), 1.0, None)
    D_bray = bray_curtis(X_rel); save_dm_pcoa(D_bray, sids, outdir, "braycurtis")
    Xbin = (X > 0).astype(int)
    D_jac = jaccard_bin(Xbin);  save_dm_pcoa(D_jac, sids, outdir, "jaccard")

    # 5) Plots (opcional)
    meta_df = None
    if args.metadata and Path(args.metadata).exists():
        meta_df = pd.read_csv(args.metadata, sep="\t")
        if "sample" not in meta_df.columns: meta_df.rename(columns={meta_df.columns[0]:"sample"}, inplace=True)

    do_static = bool(args.plots_static)
    do_inter  = bool(args.plots_interactive)

    # Alpha
    alpha_reset = alpha.reset_index()
    plot_alpha_bars(alpha_reset.set_index("sample"), outdir, interactive=False if do_static else False) if do_static else None
    plot_alpha_bars(alpha_reset.set_index("sample"), outdir, interactive=True) if do_inter else None
    plot_alpha_box_by_group(alpha_reset.set_index("sample"), meta_df, "shannon", outdir, interactive=False if do_static else False) if do_static else None
    plot_alpha_box_by_group(alpha_reset.set_index("sample"), meta_df, "shannon", outdir, interactive=True) if do_inter else None

    # Distancias: heatmap y dendrograma
    plot_distance_heatmap(outdir / "braycurtis_dm.tsv", "braycurtis", outdir, interactive=False if do_static else False) if do_static else None
    plot_distance_heatmap(outdir / "jaccard_dm.tsv",   "jaccard",   outdir, interactive=False if do_static else False) if do_static else None
    plot_distance_heatmap(outdir / "braycurtis_dm.tsv", "braycurtis", outdir, interactive=True) if do_inter else None
    plot_distance_heatmap(outdir / "jaccard_dm.tsv",   "jaccard",   outdir, interactive=True) if do_inter else None

    # Composición / abundancias (requiere relabund + taxonomy)
    if rel_path.exists() and tax_path.exists():
        plot_stacked_bar_top_taxa(rel_path, tax_path, outdir, level="genus", topn=args.topn_genus, interactive=False if do_static else False) if do_static else None
        plot_stacked_bar_top_taxa(rel_path, tax_path, outdir, level="genus", topn=args.topn_genus, interactive=True) if do_inter else None
        plot_taxa_heatmap(rel_path, tax_path, outdir, level="genus", topn=max(2*args.topn_genus, 20), log1p=True, interactive=False if do_static else False) if do_static else None
        plot_taxa_heatmap(rel_path, tax_path, outdir, level="genus", topn=max(2*args.topn_genus, 20), log1p=True, interactive=True) if do_inter else None
        plot_rank_abundance(rel_path, outdir, interactive=False if do_static else False) if do_static else None
        plot_rank_abundance(rel_path, outdir, interactive=True) if do_inter else None
        plot_treemap(rel_path, tax_path, outdir, level="phylum", interactive=False if do_static else False) if do_static else None
        plot_treemap(rel_path, tax_path, outdir, level="phylum", interactive=True) if do_inter else None
        plot_sunburst(rel_path, tax_path, outdir, interactive=True) if do_inter else None

    eprint("Listo. Métricas y figuras generadas.")
    return 0

if __name__ == "__main__":
    sys.exit(main())
