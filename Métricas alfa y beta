def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Calcula alfa/beta/PCoA desde salidas EMU y genera plots en R.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    p.add_argument("--emu-outdir", required=True, type=Path, help="Carpeta con salidas de EMU (por muestra o agregadas).")
    p.add_argument("--outdir", type=Path, default=None, help="Carpeta de salida (por defecto = --emu-outdir).")
    p.add_argument("--min-abundance", type=float, default=0.0, help="Umbral para filtrar relativas al agregar (0 = sin filtro).")
    p.add_argument("--metadata", type=Path, default=None, help="TSV con columna 'sample' y (opcional) 'group'.")
    p.add_argument("--topn-genus", type=int, default=10, help="Top-N géneros en stacked bar.")
    p.add_argument("--r-plots", action="store_true", help="Generar plots en R (phyloseq/vegan).")
    p.add_argument("--r-env", default="base", help="Nombre del entorno conda que contiene R.")
    p.add_argument("--conda-exe", default=os.environ.get("CONDA_EXE", "conda"), help="Ejecutable conda/micromamba.")
    return p

def main() -> int:
    args = build_parser().parse_args()
    outdir = args.outdir or args.emu_outdir
    ensure_dir(outdir)

    # 1) Detectar/crear tablas agregadas
    cnt_path = outdir / "feature_table_counts.tsv"
    rel_path = outdir / "feature_table_relabund.tsv"
    tax_path = outdir / "taxonomy.tsv"

    if not (cnt_path.exists() or rel_path.exists()):
        eprint("[INFO] No hay tablas agregadas. Agregando desde TSV por muestra de EMU…")
        cnt_path, rel_path, tax_path = aggregate_from_per_sample(args.emu_outdir, outdir, args.min_abundance)

    # Leer tabla para métricas
    table = None; is_counts = False
    if cnt_path and cnt_path.exists():
        table = pd.read_csv(cnt_path, sep="\t", index_col=0)
        is_counts = True
    elif rel_path and rel_path.exists():
        table = pd.read_csv(rel_path, sep="\t", index_col=0)
        is_counts = False
    else:
        eprint("[ERROR] No encontré ni counts ni relabund para calcular métricas.")
        return 2

    # Orientación: filas=features, columnas=muestras
    # Si detecta que el index parecen SRR (muestras), transpone:
    if any(pd.Series(table.index.astype(str)).str.match(r"^(SRR|ERR|DRR)", na=False)):
        table = table.T

    # 2) Alfa diversidad
    alpha = alpha_from_table(table, is_counts=is_counts)
    alpha.to_csv(outdir / "alpha_diversity.tsv", sep="\t")

    # 3) Beta + PCoA (Bray / Jaccard)
    X = table.values.T   # samples x features
    sids = list(table.columns)

    # Bray–Curtis (normalizar a relativas para estabilidad)
    X_br = X / np.clip(X.sum(axis=1, keepdims=True), 1.0, None)
    D_bray = bray_curtis(X_br)
    save_dm_pcoa(D_bray, sids, outdir, "braycurtis")

    # Jaccard (binario)
    Xbin = (X > 0).astype(int)
    D_jac = jaccard_bin(Xbin)
    save_dm_pcoa(D_jac, sids, outdir, "jaccard")

    # 4) Plots en R (opcional)
    if args.r_plots:
        try:
            run_r_plots(outdir, args.metadata, args.topn_genus, args.conda_exe, args.r_env)
        except sp.CalledProcessError as e:
            eprint(f"[WARN] Falló la generación de plots en R: {e}")

    eprint("Listo. Métricas y (si pediste) plots en R generados.")
    return 0

if __name__ == "__main__":
    sys.exit(main())

