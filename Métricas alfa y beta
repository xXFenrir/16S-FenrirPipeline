# -------- Stacked bar (Top-N genus) --------
extract_genus <- function(x) {{
  if (is.na(x) || x == "") return("Unassigned")
  m <- regmatches(x, regexpr("g__[^;]+", x))
  g <- ifelse(length(m)>0, sub("^g__", "", m), "Unassigned")
  ifelse(is.na(g) | g=="", "Unassigned", g)
}}
if (file.exists(rel_path) && file.exists(tax_path)) {{
  rel <- readr::read_tsv(rel_path, show_col_types = FALSE)
  if (!"feature_id" %in% names(rel)) names(rel)[1] <- "feature_id"
  tax <- readr::read_tsv(tax_path, show_col_types = FALSE)
  if (!"feature_id" %in% names(tax)) names(tax)[1] <- "feature_id"
  if (!"taxonomy" %in% names(tax))  names(tax)[2] <- "taxonomy"

  rel_long <- rel |>
    tidyr::pivot_longer(-feature_id, names_to="sample", values_to="rel") |>
    dplyr::left_join(tax, by="feature_id") |>
    dplyr::mutate(genus = vapply(taxonomy, extract_genus, character(1))) |>
    dplyr::group_by(genus, sample) |>
    dplyr::summarise(rel = sum(rel, na.rm=TRUE), .groups="drop")

  topn <- rel_long |>
    dplyr::group_by(genus) |>
    dplyr::summarise(mu = mean(rel, na.rm=TRUE), .groups="drop") |>
    dplyr::arrange(dplyr::desc(mu)) |>
    dplyr::slice_head(n = opt$topn) |>
    dplyr::pull(genus)

  rel_long <- rel_long |>
    dplyr::mutate(genus2 = ifelse(genus %in% topn, genus, "Other")) |>
    dplyr::group_by(genus2, sample) |>
    dplyr::summarise(rel = sum(rel, na.rm=TRUE), .groups="drop")

  g <- ggplot(rel_long, aes(x=sample, y=rel, fill=genus2)) +
    geom_col(position="fill") + theme_bw() +
    labs(x="Sample", y="Relative abundance", fill="Genus", title=paste0("Top ", opt$topn, " géneros (+ Other)")) +
    theme(axis.text.x = element_text(angle=90, vjust=.5, hjust=1))
  ggsave(file.path(plotdir, "stacked_bar_top_genus.png"), g, width=10, height=5, dpi=150)
}}

# -------- PCoA/Adonis (vegan/phyloseq si disponibles) --------
if (!is.null(ps) && has("vegan")) {{
  library(vegan)
  # BRAY
  otu <- as(otu_table(ps), "matrix"); if (!taxa_are_rows(ps)) otu <- t(otu)
  otu_rel <- sweep(otu, 2, pmax(colSums(otu), 1), "/")
  d_bray <- vegdist(t(otu_rel), method="bray")
  cmd_bray <- cmdscale(d_bray, eig=TRUE, k=2)
  coords <- data.frame(sample = rownames(cmd_bray$points),
                       PC1 = cmd_bray$points[,1],
                       PC2 = cmd_bray$points[,2])
  if (!is.null(meta)) coords <- dplyr::left_join(coords, meta, by="sample")
  pc1 <- if (!is.null(cmd_bray$eig) && sum(cmd_bray$eig>0)>0) round(cmd_bray$eig[1]/sum(pmax(cmd_bray$eig,0))*100,1) else NA
  pc2 <- if (!is.null(cmd_bray$eig) && sum(cmd_bray$eig>0)>1) round(cmd_bray$eig[2]/sum(pmax(cmd_bray$eig,0))*100,1) else NA
  g <- ggplot(coords, aes(x=PC1, y=PC2, color=if ("group" %in% names(coords)) group else NULL)) +
    geom_point(size=2) + theme_bw() +
    labs(title="PCoA — Bray–Curtis", x=paste0("PC1 (", ifelse(is.na(pc1),"",pc1), "%)"),
         y=paste0("PC2 (", ifelse(is.na(pc2),"",pc2), "%)"))
  ggsave(file.path(plotdir, "pcoa_braycurtis_vegan.png"), g, width=6, height=5, dpi=150)

  # JACCARD (binario)
  otu_bin <- (otu > 0)*1
  d_jac <- vegdist(t(otu_bin), method="jaccard", binary=TRUE)
  cmd_jac <- cmdscale(d_jac, eig=TRUE, k=2)
  coords <- data.frame(sample = rownames(cmd_jac$points),
                       PC1 = cmd_jac$points[,1], PC2 = cmd_jac$points[,2])
  if (!is.null(meta)) coords <- dplyr::left_join(coords, meta, by="sample")
  pc1 <- if (!is.null(cmd_jac$eig) && sum(cmd_jac$eig>0)>0) round(cmd_jac$eig[1]/sum(pmax(cmd_jac$eig,0))*100,1) else NA
  pc2 <- if (!is.null(cmd_jac$eig) && sum(cmd_jac$eig>0)>1) round(cmd_jac$eig[2]/sum(pmax(cmd_jac$eig,0))*100,1) else NA
  g <- ggplot(coords, aes(x=PC1, y=PC2, color=if ("group" %in% names(coords)) group else NULL)) +
    geom_point(size=2) + theme_bw() +
    labs(title="PCoA — Jaccard", x=paste0("PC1 (", ifelse(is.na(pc1),"",pc1), "%)"),
         y=paste0("PC2 (", ifelse(is.na(pc2),"",pc2), "%)"))
  ggsave(file.path(plotdir, "pcoa_jaccard_vegan.png"), g, width=6, height=5, dpi=150)

  # PERMANOVA si hay grupos
  if (!is.null(meta) && "group" %in% names(meta)) {{
    sm <- data.frame(meta); rownames(sm) <- sm$sample
    common <- intersect(colnames(otu), rownames(sm))
    if (length(common) >= 2) {{
      bray <- vegdist(t(otu_rel[, common, drop=FALSE]), method="bray")
      jac  <- vegdist(t(otu_bin[, common, drop=FALSE]), method="jaccard", binary=TRUE)
      ad_bray <- adonis2(bray ~ sm[common, "group", drop=TRUE])
      ad_jac  <- adonis2(jac  ~ sm[common, "group", drop=TRUE])
      # guardar resultados
      write.table(as.data.frame(ad_bray), file.path(outdir, "permanova_bray.tsv"), sep="\\t", quote=FALSE)
      write.table(as.data.frame(ad_jac),  file.path(outdir, "permanova_jaccard.tsv"), sep="\\t", quote=FALSE)
    }}
  }}
}}

