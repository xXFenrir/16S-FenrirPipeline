TAX_COLS = ["superkingdom","phylum","class","order","family","genus","species"]

def eprint(*a, **k): print(*a, file=sys.stderr, **k)
def ensure_dir(p: Path): p.mkdir(parents=True, exist_ok=True)
def _norm_cols(cols: List[str]) -> Dict[str,str]: return {c.lower(): c for c in cols}

# ------------- utilidades para leer/armar tablas -------------
def _detect_rel_col(df: pd.DataFrame) -> Optional[str]:
    cands = [c for c in df.columns if re.search(r"abund", c, re.I)]
    for c in cands:
        try:
            sm = float(pd.to_numeric(df[c], errors="coerce").fillna(0).sum())
            if 0.9 <= sm <= 1.1: return c
        except Exception: pass
    for c in df.columns:
        if pd.api.types.is_numeric_dtype(df[c]):
            sm = float(pd.to_numeric(df[c], errors="coerce").fillna(0).sum())
            if 0.9 <= sm <= 1.1: return c
    return None

def _detect_count_col(df: pd.DataFrame) -> Optional[str]:
    cands = [c for c in df.columns if re.fullmatch(r"count[s]?", c, re.I)]
    for c in cands:
        if pd.api.types.is_numeric_dtype(df[c]): return c
    for c in df.columns:
        if pd.api.types.is_numeric_dtype(df[c]):
            if float(pd.to_numeric(df[c], errors="coerce").fillna(0).sum()) > 1.1:
                return c
    return None

def _taxonomy_string(row: pd.Series) -> str:
    labels = ["k__","p__","c__","o__","f__","g__","s__"]
    out = []
    for lab, key in zip(labels, TAX_COLS):
        val = str(row.get(key, "Unassigned") or "Unassigned")
        out.append(f"{lab}{val}")
    return "; ".join(out)

def _feature_id(row: pd.Series) -> str:
    tax_id = str(row.get("tax_id", "") or "")
    if tax_id: return f"id|{tax_id}"
    return "tax|" + "|".join(str(row.get(k, "Unassigned") or "Unassigned").replace("|","_") for k in TAX_COLS)

def _read_tsv(path: Path) -> Optional[pd.DataFrame]:
    try:
        return pd.read_csv(path, sep="\t")
    except Exception as e:
        eprint(f"[WARN] No pude leer {path}: {e}"); return None

def _find_per_sample_tsvs(emu_outdir: Path, kind: str) -> Dict[str, Path]:
    pattern = "*rel*abundance*.tsv" if kind=="rel" else "*count*.tsv"
    hits: Dict[str, Path] = {}
    for p in emu_outdir.rglob(pattern):
        sample = p.parent.name
        hits[sample] = p
    return hits

def aggregate_from_per_sample(emu_outdir: Path, outdir: Path, min_abundance: float=0.0
                              ) -> Tuple[Optional[Path], Optional[Path], Optional[Path]]:
    rel_paths = _find_per_sample_tsvs(emu_outdir, "rel")
    cnt_paths = _find_per_sample_tsvs(emu_outdir, "counts")
    rel_tabs, cnt_tabs = [], []
    tax_map: Dict[str,str] = {}

    for sample, tsv in rel_paths.items():
        df = _read_tsv(tsv); 
        if df is None: continue
        colmap = _norm_cols(df.columns)
        for std in TAX_COLS:
            src = colmap.get(std)
            if (std not in df.columns) and src: df.rename(columns={src:std}, inplace=True)
        rel_col = _detect_rel_col(df)
        if rel_col is None:
            eprint(f"[WARN] Sin columna de relativas en {tsv}"); continue
        if min_abundance>0:
            df = df[pd.to_numeric(df[rel_col], errors="coerce").fillna(0) >= float(min_abundance)].copy()
        df["_feature_id"] = df.apply(_feature_id, axis=1)
        df["_tax"] = df.apply(_taxonomy_string, axis=1)
        for fid,t in zip(df["_feature_id"], df["_tax"]): tax_map[fid]=t
        rel_tabs.append(df[["_feature_id", rel_col]].rename(columns={rel_col: sample}).set_index("_feature_id"))

    for sample, tsv in cnt_paths.items():
        df = _read_tsv(tsv)
        if df is None: continue
        colmap = _norm_cols(df.columns)
        for std in TAX_COLS:
            src = colmap.get(std)
            if (std not in df.columns) and src: df.rename(columns={src:std}, inplace=True)
        cnt_col = _detect_count_col(df)
        if cnt_col is None:
            eprint(f"[WARN] Sin columna de conteos en {tsv}"); continue
        df["_feature_id"] = df.apply(_feature_id, axis=1)
        df["_tax"] = df.apply(_taxonomy_string, axis=1)
        for fid,t in zip(df["_feature_id"], df["_tax"]): tax_map[fid]=t
        cnt_tabs.append(df[["_feature_id", cnt_col]].rename(columns={cnt_col: sample}).set_index("_feature_id"))

    rel_path = cnt_path = tax_path = None
    if rel_tabs:
        rel_df = pd.concat(rel_tabs, axis=1).fillna(0.0)
        rel_path = outdir / "feature_table_relabund.tsv"
        rel_df.to_csv(rel_path, sep="\t")
    if cnt_tabs:
        cnt_df = pd.concat(cnt_tabs, axis=1).fillna(0.0)
        cnt_path = outdir / "feature_table_counts.tsv"
        cnt_df.to_csv(cnt_path, sep="\t")
    if tax_map:
        tax_df = pd.DataFrame({"feature_id": list(tax_map.keys()), "taxonomy": list(tax_map.values())}).sort_values("feature_id")
        tax_path = outdir / "taxonomy.tsv"
        tax_df.to_csv(tax_path, sep="\t", index=False)
    return cnt_path, rel_path, tax_path

# ------------------ métricas (Python puro) -------------------
def chao1(counts: np.ndarray) -> float:
    x = np.asarray(counts, dtype=float)
    Sobs = np.sum(x>0); f1 = np.sum(x==1); f2 = np.sum(x==2)
    return float(Sobs + (f1*f1)/(2*f2)) if f2>0 else float(Sobs + (f1*(f1-1))/2)

def shannon(p: np.ndarray) -> float:
    p = np.asarray(p, dtype=float); p = p[p>0]; 
    return float(-np.sum(p*np.log(p))) if p.size else 0.0

def simpson(p: np.ndarray) -> float:
    p = np.asarray(p, dtype=float); 
    return float(1.0 - np.sum(p*p))

def alpha_from_table(table: pd.DataFrame, is_counts: bool) -> pd.DataFrame:
    rows=[]
    for sample in table.columns:
        x = table[sample].values
        if is_counts:
            total = x.sum()
            p = x/total if total>0 else x
            obs = int(np.sum(x>0)); c1 = chao1(x)
        else:
            p = x; obs = int(np.sum(p>0)); c1 = float(obs)
        rows.append({"sample":sample,"observed":obs,"chao1":c1,"shannon":shannon(p),"simpson":simpson(p)})
    return pd.DataFrame(rows).set_index("sample")

def bray_curtis(X: np.ndarray) -> np.ndarray:
    n = X.shape[0]; D = np.zeros((n,n))
    for i in range(n):
        xi = X[i]
        for j in range(i+1,n):
            xj = X[j]
            num = np.abs(xi-xj).sum(); den = (xi+xj).sum()
            D[i,j] = D[j,i] = 0.0 if den==0 else num/den
    return D

def jaccard_bin(Xbin: np.ndarray) -> np.ndarray:
    n = Xbin.shape[0]; D = np.zeros((n,n))
    for i in range(n):
        ai = Xbin[i]>0
        for j in range(i+1,n):
            aj = Xbin[j]>0
            inter = np.logical_and(ai,aj).sum(); union = np.logical_or(ai,aj).sum()
            D[i,j] = D[j,i] = 1.0 if union==0 else 1.0 - inter/union
    return D

def pcoa(D: np.ndarray):
    n = D.shape[0]; D2 = D**2
    J = np.eye(n) - np.ones((n,n))/n
    B = -0.5 * J @ D2 @ J
    eigvals, eigvecs = np.linalg.eigh(B)
    order = np.argsort(eigvals)[::-1]
    eigvals = eigvals[order]; eigvecs = eigvecs[:,order]
    pos = eigvals > 1e-12
    eigvals = eigvals[pos]; eigvecs = eigvecs[:,pos]
    coords = eigvecs * np.sqrt(eigvals)
    var = eigvals / eigvals.sum() if eigvals.size else np.array([])
    return coords, eigvals, var

def save_dm_pcoa(D: np.ndarray, sids: List[str], outdir: Path, prefix: str):
    dm_path = outdir / f"{prefix}_dm.tsv"
    pd.DataFrame(D, index=sids, columns=sids).to_csv(dm_path, sep="\t")
    coords, eig, var = pcoa(D)
    k = min(3, coords.shape[1]) if coords.size else 0
    coords_path = outdir / f"pcoa_{prefix}_coords.tsv"
    pd.DataFrame(coords[:, :k], index=sids, columns=[f"PC{i+1}" for i in range(k)]).to_csv(coords_path, sep="\t")
    pd.DataFrame({"eigenvalue": eig}).to_csv(outdir / f"pcoa_{prefix}_eigvals.tsv", sep="\t", index=False)
    pd.DataFrame({"proportion_explained": var}).to_csv(outdir / f"pcoa_{prefix}_variance.tsv", sep="\t", index=False)
    # PNG básico
    if _HAS_MPL and k>=2:
        plt.figure()
        plt.scatter(coords[:,0], coords[:,1])
        for i,s in enumerate(sids): plt.text(coords[i,0], coords[i,1], str(s))
        xl = f"PC1 ({var[0]*100:.1f}%)" if var.size>0 else "PC1"
        yl = f"PC2 ({var[1]*100:.1f}%)" if var.size>1 else "PC2"
        plt.xlabel(xl); plt.ylabel(yl); plt.title(f"PCoA — {prefix}")
        plt.tight_layout(); plt.savefig(outdir / f"pcoa_{prefix}.png", dpi=150); plt.close()
    return {"dm":dm_path,"coords":coords_path}

# ---------------------- helpers taxonómicos -------------------
def read_taxonomy(tax_path: Path) -> pd.DataFrame:
    tax = pd.read_csv(tax_path, sep="\t")
    if "feature_id" not in tax.columns: tax.rename(columns={tax.columns[0]:"feature_id"}, inplace=True)
    if "taxonomy" not in tax.columns and tax.shape[1]>=2: tax.rename(columns={tax.columns[1]:"taxonomy"}, inplace=True)
    return tax

def extract_level(series_tax: pd.Series, level: str="genus") -> pd.Series:
    """ extrae g__... (o phylum, etc.) de una cadena 'k__/p__/...' """
    prefix = dict(superkingdom="k__", kingdom="k__", phylum="p__", class_="c__", order="o__", family="f__", genus="g__", species="s__")
    pre = prefix.get(level, "g__")
    def _one(x:str):
        if not isinstance(x,str): return "Unassigned"
        m = re.search(rf"{pre}([^;]+)", x)
        val = m.group(1) if m else "Unassigned"
        return val if (val and val!="") else "Unassigned"
    return series_tax.apply(_one)

