tax_path   <- file.path(outdir, "taxonomy.tsv")

# ---- Intentar phyloseq/microbiome/vegan si están instalados ----
has <- function(pkg) requireNamespace(pkg, quietly = TRUE)

# Construye phyloseq si se puede
