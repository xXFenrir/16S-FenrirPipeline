#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
EMU.py — Ejecuta EMU sobre FASTQ 16S y guarda SOLO las salidas típicas por muestra:
- <sample>_rel-abundance.tsv
- <sample>_counts.tsv (si --keep-counts)
- <sample>_read-assignments.tsv (si --keep-assignments)
- manifest.tsv (trazabilidad)

NO calcula métricas ni PCoA. Úsalo antes de 'metricas.py'.
"""

from __future__ import annotations
import argparse, os, re, sys, shlex, shutil, subprocess as sp
from pathlib import Path
from typing import Optional, List, Tuple, Dict

def eprint(*a, **k): print(*a, file=sys.stderr, **k)
def ensure_dir(p: Path): p.mkdir(parents=True, exist_ok=True)
def which(cmd: str) -> Optional[str]: return shutil.which(cmd)

def safe_sample_name(fq: Path) -> str:
    m = re.search(r"(SRR|ERR|DRR)\d{5,}", fq.name)
    if m: return m.group(0)
    base = re.sub(r"(\.fastq(\.gz)?|\.fq(\.gz)?)$", "", fq.name, flags=re.I)
    return f"{fq.parent.name}_{base}"

def discover_fastqs(input_dir: Optional[Path], pattern: Optional[str], input_glob: Optional[str]) -> List[Path]:
    paths: List[Path] = []
    if input_glob:
        for p in Path(".").glob(input_glob):
            if p.is_file(): paths.append(p.resolve())
    if input_dir and pattern:
        for p in input_dir.rglob(pattern):
            if p.is_file(): paths.append(p.resolve())
    return sorted(set(paths))

def run_emu(emu_cmd: str, db: Path, fastq: Path, outdir_sample: Path, sample: str,
            threads: int, keep_counts: bool, keep_assignments: bool
            ) -> Tuple[Optional[Path], Optional[Path], Optional[Path]]:
    ensure_dir(outdir_sample)
    cmd = [
        emu_cmd, "abundance",
        "--db", str(db),
        "--threads", str(threads),
        "--output-dir", str(outdir_sample),
        "--output-basename", sample
    ]
    if keep_counts: cmd.append("--keep-counts")
    if keep_assignments: cmd.append("--keep-read-assignments")
    cmd.append(str(fastq))
    eprint("[EMU]", " ".join(shlex.quote(x) for x in cmd))
    try:
        sp.run(cmd, check=True)
    except sp.CalledProcessError as e:
        eprint(f"[ERROR] EMU falló para {fastq}: {e}")
        return (None, None, None)

    rel = counts = assigns = None
    for f in outdir_sample.glob("*.tsv"):
        name = f.name.lower()
        if "rel" in name and "abundance" in name: rel = f
        elif "count" in name: counts = f
        elif "assign" in name: assigns = f

    # Fallbacks
    if rel is None:
        c = outdir_sample / f"{sample}_rel-abundance.tsv"
        if c.exists(): rel = c
    if counts is None:
        c = outdir_sample / f"{sample}_counts.tsv"
        if c.exists(): counts = c
    if assigns is None:
        c = outdir_sample / f"{sample}_read-assignments.tsv"
        if c.exists(): assigns = c
    return (rel, counts, assigns)

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Corre EMU por muestra y solo guarda salidas típicas (sin métricas).",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    p.add_argument("--db", required=True, type=Path, help="Ruta a la base de datos EMU.")
    p.add_argument("--emu-cmd", default=None, help="Ruta al ejecutable 'emu' si no está en PATH.")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--input-dir", type=Path, help="Carpeta raíz con FASTQ.")
    g.add_argument("--input-glob", type=str, help="Patrón glob alternativo para FASTQ.")
    p.add_argument("--pattern", type=str, default="*_final.fastq", help="Patrón de búsqueda bajo --input-dir.")
    p.add_argument("--outdir", required=True, type=Path, help="Directorio de salida.")
    p.add_argument("--threads", type=int, default=8, help="Hilos para EMU.")
    p.add_argument("--keep-counts", action="store_true", help="Guardar conteos por taxón.")
    p.add_argument("--keep-assignments", action="store_true", help="Guardar asignaciones por lectura.")
    return p

def main() -> int:
    args = build_parser().parse_args()
    emu_cmd = args.emu_cmd or which("emu")
    if not emu_cmd:
        eprint("[ERROR] No se encontró 'emu' en PATH. Usa --emu-cmd.")
        return 2
    if not args.db.exists():
        eprint(f"[ERROR] No existe BD EMU: {args.db}")
        return 2
    ensure_dir(args.outdir)
    fastqs = discover_fastqs(args.input_dir, args.pattern, args.input_glob)
    if not fastqs:
        eprint("[WARN] No se encontraron FASTQ con los criterios dados.")
        return 0

    eprint(f"FASTQ a procesar: {len(fastqs)}")
    manifest_rows: List[Dict[str, str]] = []
    for fq in fastqs:
        fq = Path(fq)
        sample = safe_sample_name(fq)
        sd = args.outdir / sample
        rel, cnt, asg = run_emu(emu_cmd, args.db, fq, sd, sample, args.threads, args.keep_counts, args.keep_assignments)
        manifest_rows.append({
            "sample": sample,
            "fastq": str(fq),
            "outdir_sample": str(sd),
            "rel_abundance_tsv": str(rel) if rel else "",
            "counts_tsv": str(cnt) if cnt else "",
            "assignments_tsv": str(asg) if asg else "",
        })

    import pandas as pd
    pd.DataFrame(manifest_rows).sort_values("sample").to_csv(args.outdir / "manifest.tsv", sep="\t", index=False)
    eprint("Listo. Salidas por muestra + manifest.tsv")
    return 0

if __name__ == "__main__":
    sys.exit(main())
